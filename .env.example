# Copy to .env and fill in. .env is gitignored; never commit it.

# Required for rates-refresh (Gemini extraction). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default Gemini model used by rates-refresh
GEMINI_MODEL=

# Required for property-api (LINZ Data Service). Get one at https://data.linz.govt.nz/ -> your name -> API Keys
LINZ_API_KEY=
